// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusCampanha {
  ativa
  suspensa
  encerrada
}

enum StatusConvite {
  aceito
  recusado
  pendente
}

enum TipoUsuario {
  mestre
  jogador
}

model Usuario {
  id                 Int               @id @default(autoincrement())
  nome_usuario       String
  email              String            @unique
  senha              String
  verificado         Boolean           @default(false)
  campanhasMestradas Campanha[]
  participacoes      UsuarioCampanha[]
  convites           Convite[]
  @@map("usuario")
}

model Campanha {
  id            Int               @id @default(autoincrement())
  numero        Int
  titulo        String
  criado_por    Int
  criador       Usuario           @relation(fields: [criado_por], references: [id])
  status        StatusCampanha
  participantes UsuarioCampanha[]
  convites      Convite[]
  @@map("campanha")
}

model UsuarioCampanha {
  usuario_id  Int
  campanha_id Int
  papel       TipoUsuario

  usuario     Usuario  @relation(fields: [usuario_id], references: [id])
  campanha    Campanha @relation(fields: [campanha_id], references: [id])

  @@id([usuario_id, campanha_id])
  @@map("usuario_campanha")
}

model Convite {
  id            Int               @id @default(autoincrement())
  status        StatusConvite
  usuario_id    Int
  campanha_id   Int
  convidado     Usuario  @relation(fields: [usuario_id], references: [id])
  campanha      Campanha @relation(fields: [campanha_id], references: [id])
  @@map("convite")
}