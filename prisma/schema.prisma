// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusCampanha {
  ativa
  suspensa
  encerrada
}

enum StatusAprovacao {
  pendente
  aprovada
  rejeitada
}

enum NivelHunter {
  iniciante
  veterano
  uma_estrela
  duas_estrelas
  tres_estrelas
}



enum TipoAura {
  reforco
  transmutacao
  emissao
  manipulacao
  materializacao
  especializacao
}


enum TipoFicha {
  personagem
  invocacao
  npc
}

enum StatusConvite {
  aceito
  recusado
  pendente
}

enum TipoUsuario {
  mestre
  jogador
}

model Usuario {
  id                 Int               @id @default(autoincrement())
  nome_usuario       String
  email              String            @unique
  senha              String
  verificado         Boolean           @default(false)
  campanhasMestradas Campanha[]
  participacoes      UsuarioCampanha[]
  convites           Convite[]
  personagens        Personagem[]
  @@map("usuario")
}

model Campanha {
  id            Int               @id @default(autoincrement())
  numero        Int
  titulo        String
  criado_por    Int
  criador       Usuario           @relation(fields: [criado_por], references: [id])
  status        StatusCampanha
  participantes UsuarioCampanha[]
  convites      Convite[]
  personagens   Personagem[]
  @@map("campanha")
}

model UsuarioCampanha {
  usuario_id  Int
  campanha_id Int
  papel       TipoUsuario

  usuario     Usuario  @relation(fields: [usuario_id], references: [id])
  campanha    Campanha @relation(fields: [campanha_id], references: [id])

  @@id([usuario_id, campanha_id])
  @@map("usuario_campanha")
}

model Convite {
  id            Int               @id @default(autoincrement())
  status        StatusConvite
  usuario_id    Int
  campanha_id   Int
  convidado     Usuario  @relation(fields: [usuario_id], references: [id])
  campanha      Campanha @relation(fields: [campanha_id], references: [id])
  @@map("convite")
}

model Personagem {
  id                Int             @id @default(autoincrement())
  nome              String
  usuario_id        Int?
  usuario           Usuario?        @relation(fields: [usuario_id], references: [id])
  campanha_id Int
  campanha    Campanha @relation(fields: [campanha_id], references: [id])
  tipo_ficha        TipoFicha
  status_aprovacao  StatusAprovacao
  nivel_hunter      NivelHunter
  afinidade_aura    TipoAura
  potencia_aura     Int
  dominio_nen       Int
  recuperacao_aura  Int
  recuperacao_zetsu Int
  forca             Int
  destreza          Int
  vigor             Int
  carisma           Int
  manipulacao       Int
  autocontrole      Int
  inteligencia      Int
  raciocinio        Int
  determinacao      Int

  personagem_pai_id Int?
  personagemPai      Personagem?  @relation("Invocacao", fields: [personagem_pai_id], references: [id])
  invocacoes         Personagem[] @relation("Invocacao")

  xp_livre_total    Int @default(0)
  xp_livre_gasto    Int @default(0)
  xp_nen_total      Int @default(0)
  xp_nen_gasto      Int @default(0)

  alteracoes_pendentes AlteracaoPendente[]

  @@map("personagem")
}

model AlteracaoPendente {
  id             Int      @id @default(autoincrement())
  personagem_id  Int

  forca          Int?
  destreza       Int?
  vigor          Int?
  carisma        Int?
  manipulacao    Int?
  autocontrole   Int?
  inteligencia   Int?
  raciocinio     Int?
  determinacao   Int?
  potencia_aura  Int?
  dominio_nen    Int?

  xp_livre_gasto Int      @default(0)
  xp_nen_gasto   Int      @default(0)
  criado_em      DateTime @default(now())

  personagem Personagem @relation(fields: [personagem_id], references: [id])

  @@map("alteracao_pendente")
}